<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- teamID is deliberately absent. It used to carry a XXXXXXXXXX placeholder that
	     made every release build fail. With automatic signing plus the App Store Connect
	     API key the workflow passes via -authenticationKeyPath, the team is inferred from
	     the archive, and DEVELOPMENT_TEAM is owned by Config/Secrets.xcconfig. -->
	<key>destination</key>
	<string>upload</string>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
	<key>method</key>
	<string>app-store</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>testFlightInternalTestingOnly</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
