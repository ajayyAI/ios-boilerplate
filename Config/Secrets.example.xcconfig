// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Every key is optional. Leave one blank and its integration becomes a no-op.
//
// These values ship inside the binary and are recoverable with `strings`. That is
// acceptable for the publishable client keys below. It is NOT acceptable for a key
// that authorizes spend or reads user data — those belong behind your own backend.
// See docs/configuration.md.

// developer.apple.com > Membership > Team ID
DEVELOPMENT_TEAM =

// Your API. Empty means the app serves sample data and makes no request.
// A URL needs the `$()` split between the slashes: https:/$()/api.example.com
API_BASE_URL =

// RevenueCat > Project settings > API keys > Apple App Store (public SDK key)
REVENUECAT_API_KEY =

// Sentry > Settings > Projects > Client Keys (DSN)
SENTRY_DSN = https:/$()/examplePublicKey@o0.ingest.sentry.io/0

// PostHog > Project settings > Project API key (this key is write-only by design)
POSTHOG_API_KEY =
POSTHOG_HOST = https:/$()/eu.i.posthog.com
