// Settings shared by every build configuration.
//
// Values here are visible in the shipped binary. This file is for identity and
// non-secret configuration only — see Secrets.example.xcconfig for the rest.

APP_NAME = Scaffold
APP_BUNDLE_ID = com.example.Scaffold

// Your Apple Developer Team ID. Find it at developer.apple.com > Membership.
DEVELOPMENT_TEAM =

// Your backend. Empty means UserRemoteDataSource returns sample data instead of
// making a request, so a fresh clone still runs and contacts nobody.
// Same `$()` trick as POSTHOG_HOST below — see the note there.
API_BASE_URL =

// Optional integrations. An empty value selects the no-op client, so a clone with
// no Secrets.xcconfig still builds, runs and tests green.
REVENUECAT_API_KEY =
SENTRY_DSN =
POSTHOG_API_KEY =

// A URL cannot be written literally here: xcconfig treats `//` as a comment start
// anywhere in a line, including mid-value, so `https://host` truncates to `https:`.
// `$()` expands to nothing and must sit BETWEEN the two slashes to break the pair.
POSTHOG_HOST = https:/$()/eu.i.posthog.com

// Real values live here and this file is gitignored. `#include?` makes it optional,
// so the build works before you have created it.
#include? "Secrets.xcconfig"
