<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Populated from Config/*.xcconfig at build time and read back by AppConfig.
	     An unset variable substitutes to an empty string, which AppConfig treats as
	     "not configured" and answers with the no-op client. -->
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>PostHogAPIKey</key>
	<string>$(POSTHOG_API_KEY)</string>
	<key>PostHogHost</key>
	<string>$(POSTHOG_HOST)</string>
</dict>
</plist>
