<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Populated from Config/*.xcconfig at build time and read back by AppConfig.
	     An unset variable substitutes to an empty string, which AppConfig treats as
	     "not configured" and answers with the no-op client. -->
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>PostHogAPIKey</key>
	<string>$(POSTHOG_API_KEY)</string>
	<key>PostHogHost</key>
	<string>$(POSTHOG_HOST)</string>
	<key>AppGroupID</key>
	<string>$(APP_GROUP_ID)</string>
	<!-- The app uses only the platform's TLS, which is exempt from export compliance.
	     Declaring it here answers the encryption question once instead of on every
	     TestFlight upload. Change to true, and file the paperwork, if you add your own
	     cryptography. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
